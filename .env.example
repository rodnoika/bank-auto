APP_API_KEY=change-me
DATABASE_PATH=./data/bankhub.sqlite3
MAX_PDF_MB=15

# Для Vercel задайте pooled PostgreSQL URL. Если DATABASE_URL указан,
# он имеет приоритет над локальным DATABASE_PATH.
DATABASE_URL=

# Необязательно. Если ключ не задан, импорт и ручная проверка работают без ИИ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=45
