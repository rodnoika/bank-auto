// Общий серверный модуль для «Выписки → 1С».
// Поддерживает Бухгалтерию для Казахстана 3.0 на платформе 8.3.
// Документы создаются непроведенными: бухгалтер проверяет их в 1С и проводит штатно.

Функция ПолучитьПодтвержденныеОперации(БазовыйURL, APIКлюч) Экспорт
    Соединение = СоздатьСоединение(БазовыйURL);
    Запрос = Новый HTTPЗапрос("/api/v1/transactions/export?status=ready");
    Запрос.Заголовки.Вставить("X-API-Key", APIКлюч);
    Запрос.Заголовки.Вставить("Accept", "application/json");

    Ответ = Соединение.Получить(Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Выписки → 1С, HTTP " + Ответ.КодСостояния + ": "
            + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Данные.items;
КонецФункции

Процедура ЗагрузитьПодтвержденныеОперации(БазовыйURL, APIКлюч) Экспорт
    Для Каждого Операция Из ПолучитьПодтвержденныеОперации(БазовыйURL, APIКлюч) Цикл
        Попытка
            Если СоздатьДокументБанка(Операция) Тогда
                ОтметитьВыгруженной(БазовыйURL, APIКлюч, Операция.id);
            КонецЕсли;
        Исключение
            ЗаписьЖурналаРегистрации(
                "ВыпискиВ1С",
                УровеньЖурналаРегистрации.Ошибка,,,,
                "Операция " + Операция.id + ": " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция ПроверитьНастройку() Экспорт
    Результат = Новый Структура;
    Результат.Вставить("ВходящийДокумент", НайтиИмяДокумента("incoming"));
    Результат.Вставить("ИсходящийДокумент", НайтиИмяДокумента("outgoing"));
    Результат.Вставить("СправочникБанковскихСчетов", ЕстьСправочник("БанковскиеСчета"));
    Результат.Вставить("СправочникКонтрагентов", ЕстьСправочник("Контрагенты"));
    Возврат Результат;
КонецФункции

Функция СоздатьДокументБанка(Операция)
    Направление = СтроковоеПоле(Операция, "direction");
    ИмяДокумента = НайтиИмяДокумента(Направление);
    Если ПустаяСтрока(ИмяДокумента) Тогда
        ВызватьИсключение "В конфигурации не найден стандартный банковский документ для направления "
            + Направление;
    КонецЕсли;

    Маркер = "BankHub:" + Формат(Операция.id, "ЧГ=0");
    Если ДокументУжеСоздан(ИмяДокумента, Маркер) Тогда
        Возврат Истина;
    КонецЕсли;

    НомерСчета = СтрЗаменить(СтроковоеПоле(Операция, "account"), " ", "");
    Если ПустаяСтрока(НомерСчета) Тогда
        ВызватьИсключение "Не указан IBAN организации";
    КонецЕсли;

    БанковскийСчет = НайтиСсылкуПоРеквизитам(
        "БанковскиеСчета", НомерСчета,
        МассивИмен("НомерСчета", "НомерСчетаБанка", "IBAN"));
    Если БанковскийСчет = Неопределено Тогда
        ВызватьИсключение "В 1С не найден банковский счет организации " + НомерСчета;
    КонецЕсли;

    БИН = СтрЗаменить(СтроковоеПоле(Операция, "counterparty_bin"), " ", "");
    Контрагент = Неопределено;
    Если Не ПустаяСтрока(БИН) Тогда
        Контрагент = НайтиСсылкуПоРеквизитам(
            "Контрагенты", БИН,
            МассивИмен("БИН", "БИНИИН", "ИИНБИН"));
        Если Контрагент = Неопределено Тогда
            ВызватьИсключение "В 1С не найден контрагент с БИН/ИИН " + БИН;
        КонецЕсли;
    КонецЕсли;

    ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
    ДокументОбъект.Дата = ДатаИзISO(СтроковоеПоле(Операция, "operation_date"));

    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("БанковскийСчет", "БанковскийСчетОрганизации", "СчетОрганизации"),
        БанковскийСчет, Истина);

    Попытка
        Организация = БанковскийСчет.Владелец;
        УстановитьПервыйРеквизит(ДокументОбъект,
            МассивИмен("Организация"), Организация, Ложь);
    Исключение
        // В некоторых редакциях организация заполняется обработчиком банковского счета.
    КонецПопытки;

    Если Контрагент <> Неопределено Тогда
        УстановитьПервыйРеквизит(ДокументОбъект,
            МассивИмен("Контрагент", "Плательщик", "Получатель"), Контрагент, Ложь);
    КонецЕсли;

    Сумма = ЧисловоеПоле(Операция, "amount");
    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("Сумма", "СуммаДокумента", "СуммаПлатежа"), Сумма, Истина);

    Назначение = СтроковоеПоле(Операция, "payment_purpose");
    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("НазначениеПлатежа", "Содержание", "ТекстПлатежа"), Назначение, Ложь);

    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("КБе", "Кбе", "КодБенефициара"),
        СтроковоеПоле(Операция, "kbe"), Ложь);
    УстановитьКНП(ДокументОбъект, СтроковоеПоле(Операция, "knp"));

    НомерБанка = СтроковоеПоле(Операция, "document_number");
    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("НомерПлатежногоДокумента", "НомерДокументаБанка", "НомерВходящегоДокумента"),
        НомерБанка, Ложь);

    // Маркер обеспечивает идемпотентность: если ответ API потеряется после записи,
    // повторный запуск найдет документ и не создаст дубль.
    УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("Комментарий"), Маркер, Истина);

    ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
    Возврат Истина;
КонецФункции

Функция НайтиИмяДокумента(Направление)
    Кандидаты = Новый Массив;
    Если НРег(Направление) = "incoming" Тогда
        Кандидаты.Добавить("ПлатежныйОрдерПоступлениеДенежныхСредств");
        Кандидаты.Добавить("ПлатежныйОрдерПоступлениеДС");
        Кандидаты.Добавить("ПлатежноеПоручениеВходящее");
    ИначеЕсли НРег(Направление) = "outgoing" Тогда
        Кандидаты.Добавить("ПлатежныйОрдерСписаниеДенежныхСредств");
        Кандидаты.Добавить("ПлатежныйОрдерСписаниеДС");
        Кандидаты.Добавить("ПлатежноеПоручениеИсходящее");
    Иначе
        Возврат "";
    КонецЕсли;

    Для Каждого ИмяДокумента Из Кандидаты Цикл
        Попытка
            Менеджер = Документы[ИмяДокумента];
            Возврат ИмяДокумента;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция ДокументУжеСоздан(ИмяДокумента, Маркер)
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Документ.Ссылка КАК Ссылка
            |ИЗ
            |   Документ." + ИмяДокумента + " КАК Документ
            |ГДЕ
            |   Документ.Комментарий = &Маркер";
        Запрос.УстановитьПараметр("Маркер", Маркер);
        Выборка = Запрос.Выполнить().Выбрать();
        Возврат Выборка.Следующий();
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция НайтиСсылкуПоРеквизитам(ИмяСправочника, Значение, ИменаРеквизитов)
    Если ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Попытка
        Менеджер = Справочники[ИмяСправочника];
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
        Попытка
            Ссылка = Менеджер.НайтиПоРеквизиту(ИмяРеквизита, Значение);
            Если ЗначениеЗаполнено(Ссылка) Тогда
                Возврат Ссылка;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Процедура УстановитьКНП(ДокументОбъект, КодКНП)
    Если ПустаяСтрока(КодКНП) Тогда
        Возврат;
    КонецЕсли;

    Если УстановитьПервыйРеквизит(ДокументОбъект,
        МассивИмен("КНП", "КодНазначенияПлатежа"), КодКНП, Ложь) Тогда
        Возврат;
    КонецЕсли;

    Для Каждого ИмяСправочника Из МассивИмен("КНП", "КодыНазначенияПлатежей") Цикл
        СсылкаКНП = НайтиСсылкуПоРеквизитам(
            ИмяСправочника, КодКНП, МассивИмен("Код", "КодКНП"));
        Если СсылкаКНП <> Неопределено Тогда
            Если УстановитьПервыйРеквизит(ДокументОбъект,
                МассивИмен("КНП", "КодНазначенияПлатежа"), СсылкаКНП, Ложь) Тогда
                Возврат;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция МассивИмен(Имя1, Имя2 = Неопределено, Имя3 = Неопределено)
    Результат = Новый Массив;
    Результат.Добавить(Имя1);
    Если Имя2 <> Неопределено Тогда
        Результат.Добавить(Имя2);
    КонецЕсли;
    Если Имя3 <> Неопределено Тогда
        Результат.Добавить(Имя3);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция УстановитьПервыйРеквизит(ДокументОбъект, Имена, Значение, Обязательно)
    Если Значение = Неопределено Тогда
        Если Обязательно Тогда
            ВызватьИсключение "Не задано обязательное значение реквизита";
        КонецЕсли;
        Возврат Ложь;
    КонецЕсли;

    Для Каждого ИмяРеквизита Из Имена Цикл
        Попытка
            ДокументОбъект[ИмяРеквизита] = Значение;
            Возврат Истина;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Если Обязательно Тогда
        ВызватьИсключение "В документе " + ДокументОбъект.Метаданные().Имя
            + " не найден подходящий обязательный реквизит";
    КонецЕсли;
    Возврат Ложь;
КонецФункции

Функция СтроковоеПоле(СтруктураJSON, ИмяПоля)
    Значение = Неопределено;
    Если СтруктураJSON.Свойство(ИмяПоля, Значение) И Значение <> Неопределено Тогда
        Возврат СокрЛП(Строка(Значение));
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ЧисловоеПоле(СтруктураJSON, ИмяПоля)
    Значение = Неопределено;
    Если Не СтруктураJSON.Свойство(ИмяПоля, Значение) Или Значение = Неопределено Тогда
        ВызватьИсключение "Не заполнено числовое поле " + ИмяПоля;
    КонецЕсли;
    Возврат Число(Значение);
КонецФункции

Функция ДатаИзISO(СтрокаДаты)
    Если СтрДлина(СтрокаДаты) < 10 Тогда
        ВызватьИсключение "Некорректная дата операции: " + СтрокаДаты;
    КонецЕсли;
    Возврат Дата(
        Число(Лев(СтрокаДаты, 4)),
        Число(Сред(СтрокаДаты, 6, 2)),
        Число(Сред(СтрокаДаты, 9, 2)));
КонецФункции

Функция ЕстьСправочник(ИмяСправочника)
    Попытка
        Менеджер = Справочники[ИмяСправочника];
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Процедура ОтметитьВыгруженной(БазовыйURL, APIКлюч, ID)
    Соединение = СоздатьСоединение(БазовыйURL);
    Запрос = Новый HTTPЗапрос("/api/v1/transactions/" + Формат(ID, "ЧГ=0") + "/mark-exported");
    Запрос.Заголовки.Вставить("X-API-Key", APIКлюч);
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Не удалось отметить операцию " + ID + ": "
            + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
КонецПроцедуры

Функция СоздатьСоединение(БазовыйURL)
    URL = СокрЛП(БазовыйURL);
    HTTPS = Лев(НРег(URL), 8) = "https://";
    Если HTTPS Тогда
        Адрес = Сред(URL, 9);
        Порт = 443;
    ИначеЕсли Лев(НРег(URL), 7) = "http://" Тогда
        Адрес = Сред(URL, 8);
        Порт = 80;
    Иначе
        ВызватьИсключение "Адрес сервиса должен начинаться с http:// или https://";
    КонецЕсли;

    ПозицияПути = СтрНайти(Адрес, "/");
    Если ПозицияПути > 0 Тогда
        Адрес = Лев(Адрес, ПозицияПути - 1);
    КонецЕсли;

    ПозицияПорта = СтрНайти(Адрес, ":");
    Если ПозицияПорта > 0 Тогда
        Порт = Число(Сред(Адрес, ПозицияПорта + 1));
        Адрес = Лев(Адрес, ПозицияПорта - 1);
    КонецЕсли;

    Если HTTPS Тогда
        Возврат Новый HTTPСоединение(
            Адрес, Порт,,,,, Новый ЗащищенноеСоединениеOpenSSL());
    КонецЕсли;
    Возврат Новый HTTPСоединение(Адрес, Порт);
КонецФункции
